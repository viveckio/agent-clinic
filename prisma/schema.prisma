generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model CareItem {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  kind         String
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Appointment {
  id           String   @id @default(cuid())
  agentName    String
  contactEmail String
  requestedAt  DateTime
  status       String   @default("PENDING")
  careItemId   String
  careItem     CareItem @relation(fields: [careItemId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([requestedAt])
  @@index([status, requestedAt])
  @@index([careItemId])
}
